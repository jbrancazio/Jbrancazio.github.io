---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPostsNewestFirst } from '../lib/content';

const posts = await getPostsNewestFirst();
---

<Base title="Writing" description="Posts by Joshua Brancazio on data science and analytics.">
  <h1>Writing</h1>
  <p class="muted">
    These are from my old blog, From Espresso Shots to Data Plots, written during my bootcamp and the
    year after, 2018 to 2020. They are older and I have left them as I wrote them.
  </p>
  <PostList posts={posts} />
</Base>
